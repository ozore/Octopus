{
  "name": "@octopus/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, headless platform for the phase-4 apps (WageLens, Certly, StateReady): auth (magic link + org accounts), billing (Stripe hosted Checkout, Portal, webhook-as-truth), email (Resend), events (usage metrics), jobs (queue + Vercel Cron drain), db (Drizzle + PGlite), legal page content, env parsing.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./runtime": "./src/runtime.ts",
    "./db": "./src/db/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./auth": "./src/auth/index.ts",
    "./billing": "./src/billing/index.ts",
    "./email": "./src/email/index.ts",
    "./events": "./src/events/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./legal": "./src/legal/index.ts",
    "./http": "./src/http/index.ts",
    "./next": "./src/next/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7",
    "resend": "^6.1.2",
    "stripe": "^19.1.0",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "drizzle-kit": "^0.31.5",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true }
  }
}
