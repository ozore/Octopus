document.addEventListener("DOMContentLoaded", function () {
  const gifUrl = "https://tsbpe.texas.gov/wp-content/uploads/2026/04/TSBPE_AskKevin_NeedHelp_ANI_Smaller.gif";
  const fallbackUrl = "https://tsbpe.texas.gov/ask-kevin/";

  const style = document.createElement("style");
  style.innerHTML = `
    /* Hide ONLY the Chatbase launcher bubble, not the chat window */
    #chatbase-bubble-button,
    iframe#chatbase-bubble-button,
    [id^='chatbase'][class*='bubble-button'],
    [id^='chatbase'][class*='launcher'],
    [id^='chatbase'][class*='widget-button'] {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }

    #ask-kevin-launcher {
      position: fixed;
      left: 20px;
      bottom: 20px;
      width: 82px;
      height: 82px;
      z-index: 99999999;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      margin: 0;
      border: 0;
      background: transparent;
      appearance: none;
      -webkit-appearance: none;
    }

    #ask-kevin-launcher img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #ask-kevin-launcher.ask-kevin-fallback {
      width: auto;
      height: auto;
      padding: 12px 16px;
      border-radius: 10px;
      background: #0a2242;
      color: #ffffff;
      font: 700 16px/1.2 Arial, sans-serif;
    }

    @media (max-width: 767px) {
      #ask-kevin-launcher {
        width: 64px;
        height: 64px;
        left: 14px;
        bottom: 14px;
      }
      #ask-kevin-launcher.ask-kevin-fallback {
        width: auto;
        height: auto;
      }
    }
  `;
  document.head.appendChild(style);

  function tryOpenChatbase() {
    if (window.chatbase && typeof window.chatbase.open === "function") {
      window.chatbase.open();
      return true;
    }
    return false;
  }

  function openChat() {
    if (tryOpenChatbase()) return;

    let tries = 0;
    const interval = setInterval(function () {
      tries++;
      if (tryOpenChatbase()) {
        clearInterval(interval);
      } else if (tries >= 20) {
        clearInterval(interval);
        window.location.href = fallbackUrl;
      }
    }, 300);
  }

  if (!document.getElementById("ask-kevin-launcher")) {
    const launcher = document.createElement("button");
    launcher.id = "ask-kevin-launcher";
    launcher.type = "button";
    launcher.setAttribute("aria-label", "Open Ask Kevin chat");

    const img = document.createElement("img");
    img.src = gifUrl;
    img.alt = "Ask Kevin";
    img.loading = "eager";
    img.decoding = "async";

    img.onerror = function () {
      launcher.classList.add("ask-kevin-fallback");
      launcher.textContent = "Ask Kevin";
    };

    launcher.appendChild(img);
    launcher.addEventListener("click", openChat);
    document.body.appendChild(launcher);
  }

  function hideChatbaseLauncher() {
    // Target only the launcher bubble — never the chat window
    const launcherSelectors = [
      "#chatbase-bubble-button",
      "iframe[src*='chatbase.co'][title*='button' i]",
      "iframe[src*='chatbase.co'][title*='launcher' i]",
      "[id^='chatbase'][class*='button']",
      "[id^='chatbase'][class*='launcher']"
    ];

    launcherSelectors.forEach(function (sel) {
      document.querySelectorAll(sel).forEach(function (el) {
        el.style.setProperty("display", "none", "important");
        el.style.setProperty("visibility", "hidden", "important");
        el.style.setProperty("opacity", "0", "important");
        el.style.setProperty("pointer-events", "none", "important");
      });
    });

    // Also hide small fixed iframes from chatbase (launcher only, not window)
    document.querySelectorAll("iframe[src*='chatbase.co']").forEach(function (el) {
      const w = el.offsetWidth;
      const h = el.offsetHeight;
      // Chat windows are typically 400px+ tall; launchers are small squares
      if (w <= 120 && h <= 120) {
        el.style.setProperty("display", "none", "important");
        el.style.setProperty("visibility", "hidden", "important");
        el.style.setProperty("opacity", "0", "important");
        el.style.setProperty("pointer-events", "none", "important");
      }
    });
  }

  hideChatbaseLauncher();

  const observer = new MutationObserver(function () {
    hideChatbaseLauncher();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  window.addEventListener("load", hideChatbaseLauncher);
  setTimeout(hideChatbaseLauncher, 500);
  setTimeout(hideChatbaseLauncher, 1000);
  setTimeout(hideChatbaseLauncher, 2500);
  setTimeout(hideChatbaseLauncher, 5000);
});
</script>
