# Clausewright — environment configuration (Twelve-Factor III).
#
# Everything that varies between deploys is here. ZERO secrets in the repo:
# copy this to .env.local for development, and set production values with
# `fly secrets set`. src/env.ts validates all of it at boot with Zod and fails
# fast on a missing or malformed var.

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database (ADR-005: also the queue and the scheduler) -------------------
# `pglite` is a dev/test-only fallback and is rejected in production.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clausewright
DATABASE_POOL_MAX=10

# --- Adapters ---------------------------------------------------------------
# `mock` binds the in-repo fakes for Anthropic/Stripe/Resend/NoticeSource.
# The test suite runs in `mock`; production refuses it.
ADAPTER_MODE=live

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=

# --- Stripe (ADR-007: hosted Checkout, webhooks are the source of truth) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_RESCUE=price_xxxxxxxx
STRIPE_PRICE_RESCUE_HUMAN=price_xxxxxxxx
STRIPE_PRICE_SHIELD_MONTHLY=price_xxxxxxxx

# --- Resend (outbound + inbound; ADR-006 makes Shield possible) -------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_INBOUND_SIGNING_SECRET=whsec_inbound_xxxxxxxx
EMAIL_FROM="Clausewright <hello@clausewright.com>"
SHIELD_INGEST_DOMAIN=in.clausewright.com

# --- Engine pinning (LLM_ENGINE.md ADR-101) ---------------------------------
# A model change is an ADR and a corpus-release bump, never a config tweak:
# every case row is attributed to the model that drafted it.
MODEL_CLASSIFY=claude-sonnet-5
MODEL_DRAFT=claude-opus-5
MODEL_CRITIQUE=claude-sonnet-5

# --- Corpus attribution (baked at BUILD time; ADR-003 / ADR-008) ------------
# `npm run corpus:check` prints the prompt_bundle_hash to stamp here; it is
# derived from corpus CONTENT only, so a deploy that changes no policy text
# keeps the warm prompt cache.
CORPUS_RELEASE=0
PROMPT_BUNDLE_HASH=unbuilt
# Where the corpus content directory lives. Unset = {cwd}/corpus, which is what
# the image provides. Point it elsewhere only for a fixture tree, never to swap
# corpora in a deploy — that would break outcome attribution.
# CORPUS_DIR=
# Stamped into the page as NEXT_PUBLIC_BUILD_SHA. A BUILD-time value.
# BUILD_SHA=dev
# 5m default. The scheduler switches to 1h only during an observed traffic burst.
CORPUS_CACHE_TTL=5m

# --- Worker (ADR-005) -------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=5
WORKER_ID=worker-local
# Set to false to import the worker module without starting its poll loop
# (tests do this). Never set in a deploy.
# CLAUSEWRIGHT_WORKER_AUTOSTART=true

# --- Ops console (separate auth boundary; N4 — no customer accounts) --------
OPS_SHARED_SECRET=change-me

# --- Gates and flags --------------------------------------------------------
# G6: no surface may state a delivery-time guarantee until the automatic
# SLO-refund job runs in production and has been exercised on a breached test
# case. The SLO itself is measured from day one either way.
TIME_GUARANTEE_ADVERTISED=false
SLO_MINUTES=10
# ADR-006 third NoticeSource: a flagged hypothesis, off until counsel review.
FEATURE_STOREFRONT_RADAR=false
