{
  "name": "ratepin",
  "version": "0.1.0",
  "private": true,
  "description": "Ratepin — certified-payroll rate-of-record engine for open-shop specialty subcontractors on Davis-Bacon work. One deployable, two process types (web, worker), one Postgres.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "worker": "tsx src/worker/index.ts",
    "corpus:ingest": "tsx src/scripts/corpus-ingest.ts",
    "canary": "tsx src/scripts/canary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stripe": "^19.1.0",
    "tsx": "^4.20.6",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.5",
    "fast-check": "^4.3.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
