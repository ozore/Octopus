# =============================================================================
# RATEPIN — environment
#
# Twelve-Factor III (ARCHITECTURE.md §2.2): every deploy-varying value is an
# environment variable, Zod-validated at boot by `src/lib/config.ts`. Boot fails
# loudly on a missing or malformed var — there is no default that quietly does the
# wrong thing in production.
#
# Copy to `.env.local` for development. Never commit a filled-in copy.
# =============================================================================

# --- Process ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# BUILD_SHA and ENGINE_VERSION are stamped into every artifact's provenance block
# (ARCHITECTURE §5.3, I6). They are set by the build, not by a human.
BUILD_SHA=dev
ENGINE_VERSION=1

# --- Database (ADR-005: Postgres is the DB, the queue and the tenant boundary) --
# `pglite` is a dev/test-only fallback so the suite runs with no network and no
# container. `src/lib/config.ts` rejects it outright when NODE_ENV=production.
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://localhost:5432/ratepin
DATABASE_POOL_MAX=10

# The database role the application connects as. It is NOT the owner of the
# corpus tables and it has no UPDATE grant on them (I5), and RLS is FORCEd against
# it (ADR-011). Changing this to a superuser silently disables every tenant policy.
DATABASE_APP_ROLE=ratepin_app

# --- Adapter mode -------------------------------------------------------------
# `mock` binds the in-repo recorded fixtures for Anthropic, Stripe, R2 and every
# upstream source. Tests and CI run in `mock`; no test may require a real key.
ADAPTER_MODE=live

# --- Anthropic (setup path only — never on the filing critical path, I3) -------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# ENGINE.md ADR-101 / E8: one model for both jobs. A model change is an ADR and a
# release, never a config tweak; it is read from env only so staging can pin a
# different release of the same decision.
MODEL_CLASSIFY=claude-sonnet-5
MODEL_NARRATIVE=claude-sonnet-5
# ENGINE.md §17 / P12: the monthly inference budget. Exhaustion degrades L-D to
# L-E (the lexical picker), it never blocks a filing.
MODEL_MONTHLY_BUDGET_CENTS=20000

# --- Stripe (ADR-007: webhooks are the source of truth for money) --------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RATE_CARD=price_rate_card_49
STRIPE_PRICE_SOLO=price_solo_99
STRIPE_PRICE_CREW=price_crew_249
STRIPE_PRICE_MULTI=price_multi_599

# --- Object storage (ARCHITECTURE §2.4: artifacts are the product) -------------
# Reached only by `artifacts/download/**` and the ingest workers. A presigned URL
# is never handed to a browser, a mail client or a log (§3.1, HIGH-4).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ratepin
R2_ENDPOINT=

# --- Transactional email ------------------------------------------------------
# Outbound only. There is no inbound adapter, by design: an inbound address in the
# compliance flow is an anti-feature (A3, ARCHITECTURE §2.4).
RESEND_API_KEY=
EMAIL_FROM=Ratepin <notifications@ratepin.com>

# --- Upstream sources: five independent failure domains (ARCHITECTURE §3.4) ----
# Each is an attached resource addressed by URL (factor IV), because SAM's index
# and document endpoints failing together must be an observation, not an
# assumption.
SAM_INDEX_BASE=https://sam.gov/api/prod/sgs/v1/search/
SAM_WDOL_BASE=https://sam.gov/api/prod/wdol/v1/wd/
ECFR_BASE=https://www.ecfr.gov/api/versioner/v1/
DIR_XSD_URL=https://www.dir.ca.gov/public-works/CPR.xsd
WHD_FORM_URL=https://www.dol.gov/agencies/whd/forms/wh347

# ADR-009: the CA XSD advertises version="1.0" while DIR publishes it as V1.3.
# Version attributes lie; hashes do not. Held in CONFIG rather than in code so
# rotating it is a config change with a release record, not a code change that can
# be slipped in. A mismatch blocks CA eCPR generation entirely (L4) and nothing
# else (ARCHITECTURE §4.5).
DIR_XSD_SHA256=2ea52e977ab4ac74f7bb99aa9fb7634de8b48db7e090864150428b63c800d01a

# --- The degradation ladder and the freshness clock (D7, ARCHITECTURE §4.5) ----
# L1 DATED at 24h, L2 STALE at 72h. STALE blocks NEW pins and NEW rate assertions;
# it never blocks a filing on an already-pinned project.
FRESHNESS_DATED_HOURS=24
FRESHNESS_SLA_HOURS=72

# --- Staleness auto-credit (D7, gated by G6; ARCHITECTURE §9.4) ---------------
# The ceiling is max(CREDIT_FLOOR_CENTS, pct x MRR), evaluated per incident, and
# is never silent (AS-7). G6: the credit must fire correctly in a chaos test —
# upstream killed in staging — before the guarantee is advertised anywhere.
CREDIT_CEILING_PCT=100
CREDIT_FLOOR_CENTS=100
CREDIT_GUARANTEE_ADVERTISED=false

# --- Gate flags: a claim is rendered from its counter, never from an opinion ---
# ARCHITECTURE §14, CORRECTIONS.md §0.2. Each stays false until its gate clears;
# while false the renderer emits the mechanism sentence, not the outcome sentence
# (P-D). None of these may be flipped by hand to make copy read better.
CLAIM_G1_RATE_CORRECTNESS=false
CLAIM_G2_FORM_ACCEPTANCE=false
CLAIM_G3_CORPUS_COMPLETENESS=false
CLAIM_G4_TIME_SAVED=false
CLAIM_G5_AUTONOMY=false

# --- Encryption (ARCHITECTURE §11.3) ------------------------------------------
# Per-tenant data key for `workers.ssn_ciphertext`. Account deletion destroys the
# key, which is what makes residual ciphertext in a backup permanently
# undecryptable — the one erasure guarantee that survives a store we do not
# control (§5.5).
KMS_KEY_URI=
