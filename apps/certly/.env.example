# ---------------------------------------------------------------------------
# Certly — every variable that varies between deploys. NAMES ONLY.
# Copy to .env.local for local work; set the real values in Vercel.
# Nothing in this file is a secret, and nothing in it may ever become one.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
# THE PRODUCT NAME IS CONFIGURATION. IDENTITY.md §2.3 recommends renaming to
# "Coverfile" (keeping the slug `certly`); every customer-facing surface renders
# APP_NAME, so the rename is this one variable plus the Stripe product names.
APP_NAME="Certly"
APP_SLUG=certly
APP_BASE_URL=http://localhost:3000
COMPANY_NAME=TheVillage
COMPANY_ADDRESS="1 Example Street, Wilmington DE"
SUPPORT_EMAIL=support@thevillage.example

# We do NOT own certly.app — IDENTITY.md §2.1 records it as somebody else's
# parked placeholder (REVIEW.md B-11). Every vendor-facing link is built from
# these, and a hardcoded domain fails the build.
APP_ORIGIN=
INBOUND_DOMAIN=
SENDING_DOMAIN=

# --- Modes ------------------------------------------------------------------
# mock  = in-repo fakes for Stripe and Resend, and the in-memory DocumentStore.
#         Refused in production.
# live  = the real vendors.
ADAPTER_MODE=mock
# pglite = in-process Postgres, no container, no network. Refused in production.
DATABASE_DRIVER=pglite

# --- Database (Neon, via the Vercel Marketplace) ----------------------------
# Set DATABASE_DRIVER=postgres and paste Neon's POOLED connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Document storage (Vercel Blob; REVIEW.md §3) ---------------------------
# Uploads are BROWSER-DIRECT with a server-issued token: a Vercel Function's
# request body caps far below our 20 MB limit (REVIEW.md MJ-17).
BLOB_READ_WRITE_TOKEN=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# One per plan in src/lib/plans.ts — see STRIPE_SETUP.md (generated by
# `npm run stripe:setup`). The tier metric is TRACKED VENDORS (REVIEW.md B-10),
# so the Stripe metadata key is `vendor_limit`, never `cert_limit`.
STRIPE_PRICE_CERTLY_STARTER_MONTHLY=
STRIPE_PRICE_CERTLY_STANDARD_MONTHLY=
STRIPE_PRICE_CERTLY_PORTFOLIO_MONTHLY=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Certly <hello@example.com>"
EMAIL_REPLY_TO=
# specs/07 §9: false everywhere but production. The dev and preview formations
# render the email to the log and send nothing.
SEND_ENABLED=false

# --- Anthropic (M4 extraction; PREREQUISITES.md P7) -------------------------
# Not used by sub-wave A. The unit suite has no network and no key.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4-5

# --- The Free Gap Report (M15) ----------------------------------------------
# specs/15 §11. Anonymous traffic spending real inference money is the easiest
# way to lose money on this product; the cap is a launch requirement.
GAP_REPORT_DAILY_SPEND_CAP_CENTS=2000

# --- Auth -------------------------------------------------------------------
SESSION_COOKIE_NAME=certly_session
SESSION_TTL_DAYS=30
SESSION_ROTATE_AFTER_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=20

# --- Ops --------------------------------------------------------------------
# Guards /admin. Any long random string.
OPS_SHARED_SECRET=
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/drain.
CRON_SECRET=
JOBS_BATCH_SIZE=20

# --- Flags ------------------------------------------------------------------
BILLING_ENABLED=true
SIGNUPS_ENABLED=true

# --- Optional ---------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
