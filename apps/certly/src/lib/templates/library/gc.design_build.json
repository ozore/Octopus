  "label": "General contractor — design-build subcontractor",
  "summary": "The high-hazard trade limits plus professional liability. Professional liability is written claims-made and that is acceptable here, unlike the general liability.",
  "confidence": "medium",
  "unverified": false,
  "requirements": [
    {
      "kind": "limit",
      "coverage": "general_liability",
