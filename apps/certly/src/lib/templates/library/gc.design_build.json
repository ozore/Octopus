    {
      "kind": "limit",
      "coverage": "general_liability",
      "limit": "general_aggregate",
      "min": 5000000,
      "combinable": true
    },
    {
      "kind": "limit",
      "coverage": "automobile_liability",
      "limit": "combined_single_limit",
      "min": 1000000
    },
    {
      "kind": "coverage_present",
      "coverage": "workers_compensation",
      "note": "Statutory workers' compensation, as required by the state the work is performed in."
    },
    {
      "kind": "limit",
      "coverage": "workers_compensation",
      "limit": "el_each_accident",
      "min": 1000000
    },
    {
      "kind": "coverage_present",
      "coverage": "other",
      "other_label": "Professional Liability",
      "note": "Design-build work needs professional liability. It is written claims-made and that is acceptable for this coverage; the general liability must still be occurrence."
    },
    {
      "kind": "endorsement",
