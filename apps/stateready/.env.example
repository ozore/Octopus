# ---------------------------------------------------------------------------
# StateReady — every variable that varies between deploys. NAMES ONLY.
# Copy to .env.local for local work; set the real values in Vercel.
# Nothing in this file is a secret, and nothing in it may become one.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
# The product name is read from the environment; no page hard-codes it.
APP_NAME="StateReady"
APP_SLUG=stateready
APP_BASE_URL=http://localhost:3000
COMPANY_NAME=TheVillage
# CAN-SPAM requires this in commercial mail, and specs/12 FAILS THE BUILD
# without it rather than shipping a placeholder address (PREREQUISITES P10).
COMPANY_ADDRESS=
SUPPORT_EMAIL=

# --- Modes ------------------------------------------------------------------
# mock  = in-repo fakes for Stripe and Resend (dev, tests, e2e). Refused in production.
# live  = the real vendors.
ADAPTER_MODE=mock
# pglite = in-process Postgres, no container, no network. Refused in production.
DATABASE_DRIVER=pglite

# --- Database (Neon, via the Vercel Marketplace) ----------------------------
# Set DATABASE_DRIVER=postgres and paste Neon's POOLED connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Documents --------------------------------------------------------------
# memory = in-process (tests, local). blob = Vercel Blob (live).
DOCUMENT_STORE=memory
BLOB_READ_WRITE_TOKEN=

# --- Cron -------------------------------------------------------------------
# MUST match vercel.json. `DRAIN_INTERVAL` is derived from it at boot, and a
# sub-daily expression with VERCEL_PLAN=hobby FAILS THE BUILD: Vercel Hobby
# allows one invocation a day and silently coerces anything more frequent.
# On Pro (PREREQUISITES P1) set "0 * * * *" here and in vercel.json, and
# VERCEL_PLAN=pro. No code changes.
CRON_EXPRESSION="0 12 * * *"
VERCEL_PLAN=hobby

# --- Stripe -----------------------------------------------------------------
# The canonical product list is specs/09 §Stripe product list. trial_period_days
# is 0 on every price: the 14-day trial is app-managed and no-card (D1).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_SINGLE_MONTHLY=
STRIPE_PRICE_SINGLE_ANNUAL=
STRIPE_PRICE_MULTISTATE_MONTHLY=
STRIPE_PRICE_MULTISTATE_ANNUAL=
STRIPE_PRICE_PLATFORM_MONTHLY=
STRIPE_PRICE_PLATFORM_ANNUAL=
# One-off State Entry Packs (specs/08). Not plans — Checkout line items.
STRIPE_PRICE_ENTRY_PACK_FIRST=
STRIPE_PRICE_ENTRY_PACK=
STRIPE_PRICE_ACQ_PACK_3=
STRIPE_PRICE_ENTRY_PACK_ADDL=
# STRIPE_PRICE_FIRST_STATE_AUDIT is DEFERRED (D1). Do not create it in Stripe;
# no code path in this app can charge it.

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="StateReady <hello@example.com>"
EMAIL_REPLY_TO=

# --- Auth -------------------------------------------------------------------
SESSION_COOKIE_NAME=stateready_session
SESSION_TTL_DAYS=30
SESSION_ROTATE_AFTER_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=20

# --- Ops --------------------------------------------------------------------
OPS_SHARED_SECRET=
CRON_SECRET=
JOBS_BATCH_SIZE=20

# --- Knowledge base ---------------------------------------------------------
# Normally VERCEL_GIT_COMMIT_SHA; override only to force a snapshot version.
KB_VERSION=

# --- Flags ------------------------------------------------------------------
BILLING_ENABLED=true
SIGNUPS_ENABLED=true

# --- Optional ---------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
