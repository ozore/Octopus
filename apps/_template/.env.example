# ---------------------------------------------------------------------------
# App Template — every variable that varies between deploys. NAMES ONLY.
# Copy to .env.local for local work; set the real values in Vercel.
# Nothing in this file is a secret, and nothing in it may become one.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
APP_NAME="App Template"
APP_SLUG=template
APP_BASE_URL=http://localhost:3000
COMPANY_NAME=TheVillage
COMPANY_ADDRESS="1 Example Street, Wilmington DE"
SUPPORT_EMAIL=support@thevillage.example

# --- Modes ------------------------------------------------------------------
# mock  = in-repo fakes for Stripe and Resend (dev, tests, e2e). Refused in production.
# live  = the real vendors.
ADAPTER_MODE=mock
# pglite = in-process Postgres, no container, no network. Refused in production.
DATABASE_DRIVER=pglite

# --- Database (Neon, via the Vercel Marketplace) ----------------------------
# Set DATABASE_DRIVER=postgres and paste Neon's POOLED connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# One per plan in src/lib/plans.ts — see STRIPE_SETUP.md (generated).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="App Template <hello@example.com>"
EMAIL_REPLY_TO=

# --- Auth -------------------------------------------------------------------
SESSION_COOKIE_NAME=octopus_session
SESSION_TTL_DAYS=30
SESSION_ROTATE_AFTER_HOURS=24
LOGIN_TOKEN_TTL_MINUTES=15
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=20

# --- Ops --------------------------------------------------------------------
# Guards /admin. Any long random string.
OPS_SHARED_SECRET=
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/drain.
CRON_SECRET=
JOBS_BATCH_SIZE=20

# --- Flags ------------------------------------------------------------------
BILLING_ENABLED=true
SIGNUPS_ENABLED=true

# --- Optional ---------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
