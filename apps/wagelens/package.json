{
  "name": "@octopus/wagelens",
  "version": "0.1.0",
  "private": true,
  "description": "The county-and-craft wage lookup that files certified payroll. Federal Davis-Bacon determinations from SAM.gov, WH-347 generation, and the modification a contract locked. Built on @octopus/platform.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:design-system && next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "stripe:setup": "tsx src/scripts/stripe-setup.ts",
    "check:design-system": "node scripts/check-design-system.mjs",
    "kb:pull": "tsx src/scripts/kb-pull.ts"
  },
  "dependencies": {
    "@octopus/platform": "*",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "playwright": "1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
