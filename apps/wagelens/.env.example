# ---------------------------------------------------------------------------
# WageLens — every variable that varies between deploys. NAMES ONLY.
# Copy to .env.local for local work; set the real values in Vercel.
# Nothing in this file is a secret, and nothing in it may become one.
#
# THE PRODUCT NAME IS AN ENVIRONMENT VARIABLE (spec WL-11 V8). Every
# user-visible string — pages, emails, PDF footers, legal pages, help articles —
# resolves it from APP_NAME. Renaming the product (PLAN.md A3 leaves the final
# name to the founder) is one line here and a redeploy; there is no code change
# and no broken link, because no slug carries the name either.
# ---------------------------------------------------------------------------

# --- Identity ---------------------------------------------------------------
APP_NAME="WageLens"
APP_SLUG=wagelens
APP_BASE_URL=http://localhost:3000
COMPANY_NAME=TheVillage
COMPANY_ADDRESS="1 Example Street, Wilmington DE"
SUPPORT_EMAIL=support@thevillage.example

# --- Modes ------------------------------------------------------------------
# mock  = in-repo fakes for Stripe, Resend and SAM.gov (dev, tests, e2e).
#         Refused in production.
# live  = the real vendors and the real SAM.gov endpoints.
ADAPTER_MODE=mock
# pglite = in-process Postgres, no container, no network. Refused in production.
DATABASE_DRIVER=pglite

# --- Database (Neon, via the Vercel Marketplace) ----------------------------
# Set DATABASE_DRIVER=postgres and paste Neon's POOLED connection string.
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Knowledge base (WL-13) -------------------------------------------------
# The SAM.gov API needs NO KEY and offers NO BULK DOWNLOAD (KNOWLEDGE_BASE KB-5):
# the corpus exists only because we build it from the index + detail endpoints.
# Base URL is configurable so KNOWLEDGE_BASE §6.4's recovery procedure is an env
# change, not a deploy.
SAM_API_BASE_URL=https://sam.gov/api/prod
# Sent on every request. Name the product and a contact URL (WL-13 V2).
SAM_USER_AGENT="WageLensBot/1.0 (+https://wagelens.example/about)"
# Courtesy budget, requests per second, across the whole process (WL-13 V3).
SAM_RATE_LIMIT_PER_SECOND=4
SAM_TIMEOUT_MS=30000
# Seed the corpus from the committed fixtures on boot. DEV AND E2E ONLY —
# it is a no-op unless ADAPTER_MODE=mock, and production refuses mock.
KB_SEED_FIXTURES=false
# Salt for the public lookup's IP hashes (WL-00 V6: a hash, never an address).
KB_IP_HASH_SALT=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# One per plan in src/lib/plans.ts — see STRIPE_SETUP.md (generated).
# There is deliberately NO STRIPE_PRICE_GC: the GC Roll-up tier is published as
# "coming" and is not for sale until WL-24 ships (OFFER.md §6.1, finding B2).
STRIPE_PRICE_CREW=
STRIPE_PRICE_SHOP=

# --- Resend -----------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="WageLens <hello@example.com>"
EMAIL_REPLY_TO=

# --- Auth -------------------------------------------------------------------
SESSION_COOKIE_NAME=wl_session
SESSION_TTL_DAYS=30
SESSION_ROTATE_AFTER_HOURS=24
# WL-01 V2 settled on 20 minutes.
LOGIN_TOKEN_TTL_MINUTES=20
LOGIN_RATE_LIMIT_PER_EMAIL_PER_HOUR=5
LOGIN_RATE_LIMIT_PER_IP_PER_HOUR=20

# --- Ops --------------------------------------------------------------------
# Guards /admin. Any long random string.
OPS_SHARED_SECRET=
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` to every /api/cron/* route.
CRON_SECRET=
JOBS_BATCH_SIZE=25

# --- Flags ------------------------------------------------------------------
BILLING_ENABLED=true
SIGNUPS_ENABLED=true

# --- Optional ---------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
